[Unit]
Description=Resonance Bridge Listener persistent ChatGPT browser host
After=network-online.target resonance-bridge.service
Wants=network-online.target
Requires=resonance-bridge.service

[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=resonance-listener
RuntimeDirectoryMode=0700
Environment=TZ=Asia/Shanghai
ExecStart=/usr/local/bin/resonance-listener-host
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/resonance-bridge/listener /run/resonance-listener

[Install]
WantedBy=multi-user.target

